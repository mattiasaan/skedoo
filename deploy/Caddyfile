# Profilo "https": Caddy ottiene e rinnova da solo il certificato per API_DOMAIN (Let's Encrypt).
# Requisiti: API_DOMAIN punta all'IP pubblico di casa e il router inoltra le porte 80 e 443 a questo Raspberry.
{
	admin off
}

{$API_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	reverse_proxy api:8000
	header -Server
	# niente access log: registrerebbe IP e browser di ogni richiesta (dati personali) senza servire alla sicurezza,
	# che usa i limiti e i log dell'API. Gli errori di Caddy finiscono comunque nei log del container.
}

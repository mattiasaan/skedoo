# Copia in .env solo se serve. Il file .env non va committato.

# Indirizzo dell'API in produzione (senza / finale). Se manca si usa /api (proxy di sviluppo di Vite).
# VITE_API_URL=https://api.tuodominio.it
# Su GitHub Pages la imposta il workflow dalla variabile di repository API_URL

# Dove il proxy di sviluppo inoltra /api (default http://localhost:8000)
# SKEDOO_API_TARGET=http://localhost:8000

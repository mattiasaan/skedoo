# Configurazione di Skedoo su QUESTO Raspberry. Crea il file vero con:  ./init-env.sh
# (genera i segreti e imposta i permessi 600). Il file .env NON va mai committato.

# ---------------------------------------------------------------- cosa gira qui
# Tutto su un Pi ........................ backend,ocr-gemini
# Due Pi: Pi del backend ................ backend
# Due Pi: Pi dell'OCR ................... ocr-gemini
# Per esporre l'API su internet aggiungi ",https" (Caddy) oppure ",tunnel" (Cloudflare Tunnel)
COMPOSE_PROFILES=backend,ocr-gemini

# ---------------------------------------------------------------- segreti (generati da init-env.sh)
POSTGRES_PASSWORD=
JWT_SECRET=
# token tra worker e OCR: DEVE essere uguale sul Pi del backend e sul Pi dell'OCR
OCR_TOKEN=
# chiavi delle notifiche push (Web Push). Vuote = notifiche spente. Se le cambi, i dispositivi
# si reiscrivono da soli alla prossima apertura dell'app
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------- log
# vuoto = journald (sul Raspberry, con journald-skedoo.conf installato: log cancellati dopo 30 giorni).
# Solo per provare il compose su un computer senza journald (Docker Desktop): LOG_DRIVER=local
# LOG_DRIVER=

# ---------------------------------------------------------------- backend (profilo backend)
# dominio pubblico dell'API (es. api.miosito.it) e origine/i del frontend, separate da virgola.
# GitHub Pages: solo l'origine, senza percorso (es. https://utente.github.io)
API_DOMAIN=
CORS_ORIGINS=
# di default = API_DOMAIN; aggiungi altri nomi separati da virgola se l'API ne ha più di uno
ALLOWED_HOSTS=

# contatto per i servizi push (Google, Mozilla, Apple). Vuoto = https://API_DOMAIN
VAPID_SUBJECT=
# di notte niente notifiche: le variazioni trovate partono alla fine del silenzio
PUSH_QUIET_START=22:00
PUSH_QUIET_END=06:30

# account ClasseViva usato per leggere la bacheca
CLASSVIVA_USERNAME=
CLASSVIVA_PASSWORD=

# dove si trova l'OCR, visto dal Pi del backend:
#   tutto su un Pi ............ http://ocr:8090
#   OCR su un Pi in LAN ....... http://192.168.1.51:8090      (IP del Pi dell'OCR)
#   OCR in un'altra rete ...... http://100.x.y.z:8090          (IP Tailscale del Pi dell'OCR)
OCR_URL=http://ocr:8090
BACHECA_FETCH_INTERVAL_SECONDS=900
BACHECA_OCR_MIN_AFFIDABILITA=alta

# solo con il profilo "tunnel": token del tunnel creato su Cloudflare Zero Trust
TUNNEL_TOKEN=

# ---------------------------------------------------------------- OCR (profilo ocr-gemini)
# su quale indirizzo del Pi dell'OCR ascolta la porta 8090:
#   tutto su un Pi ............ 127.0.0.1   (il worker usa la rete interna di Docker)
#   OCR su un altro Pi ........ 0.0.0.0     (oppure l'IP LAN / Tailscale del Pi, più restrittivo)
OCR_BIND=127.0.0.1
OCR_PORT=8090
# chiave di Google AI Studio (piano gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# modelli in ordine di preferenza, separati da virgola: finita la quota del primo si passa al successivo
# vuoto = helper/OCR/V5-Gemini/config.json (gemini-flash-latest, gemini-flash-lite-latest)
GEMINI_MODELS=

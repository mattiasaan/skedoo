ENVIRONMENT=development
JWT_SECRET=
JWT_TTL_HOURS=168
# giorni dal login dopo cui il token non si rinnova più
SESSION_MAX_DAYS=90

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=*
TRUST_PROXY_HEADERS=false

SCHEDULE_SOURCE=json
# DATA_DIR=backend/data
DATABASE_URL=
TIMEZONE=Europe/Rome
CACHE_TTL_SECONDS=60

# download di allegati e materiali: dimensione massima e download contemporanei per utente
MAX_DOWNLOAD_MB=250
MAX_PARALLEL_DOWNLOADS=2

# notifiche push delle variazioni (servono anche DATABASE_URL): chiavi da `python -m scripts.generate_vapid`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# contatto per i servizi push (Google, Mozilla, Apple): mailto:admin@dominio.it oppure https://dominio.it
VAPID_SUBJECT=
PUSH_CHECK_SECONDS=60
# di notte niente notifiche: quelle trovate partono alla fine del silenzio
PUSH_QUIET_START=22:00
PUSH_QUIET_END=06:30

RATE_LIMIT_IP=300
RATE_LIMIT_USER=60
RATE_LIMIT_UPSTREAM=20
LOGIN_ATTEMPTS=5
LOGIN_FAILURES=10

# Usate dagli script scripts/bacheca_fetch/*
CLASSVIVA_USERNAME=
CLASSVIVA_PASSWORD=
CLASSVIVA_BOARD_PATTERN=
CLASSVIVA_BOARD_OUTPUT=
CLASSVIVA_BOARD_ATTACHMENTS=
BACHECA_FETCH_INTERVAL_SECONDS=900
BACHECA_FETCH_RUN_ON_START=true
BACHECA_FETCH_LOG_LEVEL=INFO

# OCR dei cartelloni (scripts/bacheca_fetch/ocr_changes.py, usato anche da run_periodic)
BACHECA_OCR_ENABLED=true
# alta | media | bassa: le voci lette con affidabilita' inferiore vengono scartate
BACHECA_OCR_MIN_AFFIDABILITA=alta
# cartella dell'OCR (vuoto = helper/OCR/V5-Gemini) e interprete Python da usare
# (vuoto = quello del backend, che ha gia' opencv e numpy).
OCR_DIR=
OCR_PYTHON=
# solo per l'OCR come processo locale (OCR_URL vuoto): chiave di https://aistudio.google.com/apikey
# e modelli separati da virgola (vuoto = quelli di helper/OCR/V5-Gemini/config.json)
GEMINI_API_KEY=
GEMINI_MODELS=
OCR_TIMEOUT_SECONDS=1800
